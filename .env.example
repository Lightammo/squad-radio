# KOOK 机器人 Token（必填，切勿提交）
KOOK_TOKEN=
# 目标文字频道 ID（用于一次性发送测试，非 bot 常驻必需）
KOOK_CHANNEL_ID=

# ---- 云端入口 main.py / Docker 可选配置 ----
# 日志目录（默认项目根 logs/）
# SQUAD_RADIO_LOG_DIR=/app/logs
# 日志目录总大小上限 MB（默认 50，超过删最早的）
# SQUAD_RADIO_MAX_LOG_MB=50
# 终端输出开关：on / off（默认自动检测；后台静默跑设为 off）
# SQUAD_RADIO_LOG_CONSOLE=off
# 健康检查 HTTP 端口（不设则关闭；Docker 默认 8080）
# SQUAD_RADIO_HEALTH_PORT=8080
